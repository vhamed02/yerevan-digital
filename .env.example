# App
APP_NAME=Yerevan Digital
APP_ENV=local
APP_URL=http://localhost
API_URL=http://api.localhost
NEXT_PUBLIC_API_URL=http://api.localhost
NEXT_PUBLIC_APP_URL=http://localhost
# Platform host used to build per-store subdomains (<slug>.<host>). Defaults to
# yerevan.digital when unset; set per environment (e.g. localhost for local dev).
NEXT_PUBLIC_PLATFORM_HOST=yerevan.digital

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vendora
DB_USERNAME=vendora
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Mail — Brevo (Sendinblue)
MAIL_MAILER=brevo
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_ADDRESS=noreply@yerevan.digital
MAIL_FROM_NAME=Yerevan Digital

# Mailpit (local dev only)
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025

# Storage
STORAGE_DRIVER=local

# Platform merchant accounts — used to COLLECT weekly commission invoices from
# sellers. Each seller's own gateway credentials for customer -> seller checkout
# live in store_payment_gateways, not here. Leave a block empty and that gateway
# falls back to the internal sandbox flow.
#
# Idram fixes three URLs per merchant account at agreement time; register these
# for the platform account:
#   RESULT_URL  https://api.yerevan.digital/api/v1/invoices/callback/idram
#   SUCCESS_URL https://yerevan.digital/seller/invoices?paid=1
#   FAIL_URL    https://yerevan.digital/seller/invoices?failed=1
IDRAM_PLATFORM_REC_ACCOUNT=
IDRAM_PLATFORM_SECRET_KEY=
IDRAM_PLATFORM_EMAIL=

TELCELL_PLATFORM_ISSUER=
TELCELL_PLATFORM_SHOP_KEY=
TELCELL_PLATFORM_VALID_DAYS=3

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis

